# Google sign-in: server only, never use NEXT_PUBLIC_ for secrets.
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional canonical origin for production:
# AUTH_URL=https://your-verified-domain.example

# GitHub sync is owner-scoped and read-only. These allowlist users to see the
# shared server-side account inventory; NEVER leave the allowlist open.
ORBITMINDER_GITHUB_OWNER=scyllarusllc
ORBITMINDER_ALLOWED_EMAILS=

# Optional private-repository access token, minimally scoped, server side only:
# GITHUB_TOKEN=
# ORBITMINDER_PYTHON=python3

# Optional saved project panel (server-side SQLite only, no browser database access).
# Absolute path to an initialized database created by orbitminder.storage.ProjectStore.
# Without this the saved panel explicitly reports "unavailable" and GitHub check still works.
# ORBITMINDER_DB_PATH=/srv/orbitminder-private/projects.sqlite3
